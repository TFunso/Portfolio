# Local dev: point at any Postgres instance (e.g. `docker run -p 5432:5432 postgres`,
# or the same Vercel Postgres database used in production).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qcos?schema=public"

# Only needed for `prisma migrate deploy`/`migrate dev` against Neon/Vercel
# Postgres - migrations need a direct (non-pooled) connection. Locally this
# can just be the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/qcos?schema=public"

# Optional. Without it, professional summaries and review language use the
# classifier's own template sentences - the app is fully functional either
# way. With it, high-impact entries get one extra Claude call to turn the
# template into a polished, resume-ready sentence (grounded in the facts the
# classifier already extracted - it can't invent new ones).
ANTHROPIC_API_KEY=""
